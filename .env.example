# Copy to .env.local and fill in. Never commit .env.local.

# Resend API key (resend.com → API Keys). Required for newsletter sign-ups.
RESEND_API_KEY=

# Optional: Resend segment ID to add new subscribers to (resend.com → Audience → Segments).
RESEND_SEGMENT_ID=

# Optional: sender for the welcome email, e.g. "Moj blog <newsletter@tvojdomen.rs>".
# Requires a verified domain in Resend; leave empty to skip the welcome email.
RESEND_FROM_EMAIL=
